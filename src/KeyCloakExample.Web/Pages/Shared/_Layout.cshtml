<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>@ViewData["Title"]</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; }
    h1 { border-bottom: 2px solid #eee; padding-bottom: .5rem; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ddd; padding: .4rem .6rem; text-align: left; word-break: break-all; }
    .token { background: #f6f8fa; padding: .75rem; border-radius: 6px; word-break: break-all; font-family: monospace; }
    code { background: #f6f8fa; padding: .1rem .3rem; border-radius: 4px; }
    nav a { display: inline-block; margin-bottom: .35rem; }
  </style>
</head>
<body>
  <h1>@ViewData["Title"]</h1>
  @RenderBody()
</body>
</html>
